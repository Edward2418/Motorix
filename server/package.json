{
  "name": "motorix-server",
  "version": "1.0.0",
  "description": "API REST de Motorix, Sistema de Gestión para Taller Mecánico",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env server.js",
    "db:migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
