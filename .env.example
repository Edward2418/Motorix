# Copia este archivo a .env y completa los valores locales. No subas .env al repositorio.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=motorix

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Mantenimientos: umbrales para marcar un mantenimiento como "Próximo" (opcionales).
# Faltan estos días o menos, o estos kilómetros o menos.
# MAINTENANCE_SOON_DAYS=30
# MAINTENANCE_SOON_KM=1000

# Pagos (Sprint 4). Todo es opcional: sin token, Mercado Pago aparece deshabilitado y los demás métodos funcionan.
# Token de PRUEBAS de un vendedor de prueba de Mercado Pago (developers.mercadopago.com). Nunca pongas aquí uno real.
# MERCADOPAGO_ACCESS_TOKEN=
# Dirección a la que vuelve el cliente tras pagar (solo se envía si es https).
# MERCADOPAGO_BACK_URL=
# true usa el enlace de pruebas (sandbox); false, el de producción.
# MERCADOPAGO_SANDBOX=true
# Horas de vigencia del enlace de pago.
# PAYMENT_LINK_HOURS=24

# Encabezado del ticket de servicio.
# WORKSHOP_NAME=Taller Motorix (ejemplo)
# WORKSHOP_ADDRESS=Av. Principal 123, Ciudad de México
# WORKSHOP_PHONE=55 0000 0000
