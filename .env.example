# Copia este archivo a .env y completa los valores locales. No subas .env al repositorio.
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=motorix
# true cifra la conexión con TLS (obligatorio en una base en la nube como TiDB Cloud).
# DB_SSL=true
# Desfase de la hora del taller en la base. Necesario si la base trabaja en UTC (nube).
# DB_TIME_ZONE=-06:00

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Proxies de confianza delante de la API (en un hosting como Render suele ser 1). Sin valor, en local, no se confía en
# X-Forwarded-For. De él depende el límite de intentos de inicio de sesión por origen.
# TRUST_PROXY=1

# Datos de ejemplo en producción o en una base remota (npm run db:seed). Sin estas dos variables no se cargan. La
# contraseña sustituye a las publicadas de las cuentas de ejemplo.
# ALLOW_DEMO_DATA=true
# DEMO_PASSWORD=

# CORS: orígenes de navegador permitidos, separados por comas (por ejemplo https://taller.example.com). Sin valor, en
# desarrollo solo se aceptan localhost, 127.0.0.1 y [::1]. La aplicación de escritorio no depende de esto. En producción
# conviene definirlo: con valor, ya no se aceptan los orígenes locales.
# CORS_ORIGINS=

# Mantenimientos: valores de RESPALDO para los márgenes de "Próximo" (opcionales). Desde el Sprint 7 la administración
# los edita en Configuración; estos solo rigen si no hay nada guardado. Sin ninguno: 30 días y 1,000 km.
# Faltan estos días o menos, o estos kilómetros o menos.
# MAINTENANCE_SOON_DAYS=30
# MAINTENANCE_SOON_KM=1000

# Pagos (Sprint 4). Todo es opcional: sin token, Mercado Pago aparece deshabilitado y los demás métodos funcionan.
# Token de PRUEBAS de un vendedor de prueba de Mercado Pago (developers.mercadopago.com). Nunca pongas aquí uno real.
# MERCADOPAGO_ACCESS_TOKEN=
# Dirección a la que vuelve el cliente tras pagar (solo se envía si es https).
# MERCADOPAGO_BACK_URL=
# true usa el enlace de pruebas (sandbox); false, el de producción.
# MERCADOPAGO_SANDBOX=true
# Horas de vigencia del enlace de pago.
# PAYMENT_LINK_HOURS=24

# Encabezado del ticket de servicio: valores de RESPALDO (Sprint 7). La administración los edita en Configuración;
# estos solo rigen si no hay nada guardado.
# WORKSHOP_NAME=Taller Motorix (ejemplo)
# WORKSHOP_ADDRESS=Av. Principal 123, Ciudad de México
# WORKSHOP_PHONE=55 0000 0000
